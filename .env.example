DJANGO_SECRET_KEY=generate-with-scripts-init-local
CREDENTIAL_KEY=generate-with-scripts-init-local
DEBUG=0
ALLOWED_HOSTS=auto-reviewer.ainzw0rth.xyz,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://auto-reviewer.ainzw0rth.xyz
PUBLIC_URL=https://auto-reviewer.ainzw0rth.xyz
TRUST_PROXY=1
LIVE_WRITES=0
DOCKER_GID=999

# User PK of the sole Workflow editor owner; 0 disables. Account must also be a superuser.
DASHBOARD_RETRY_USER_ID=0

# Immutable local Docker image ID from: docker image inspect auto-reviewer-cli:local --format '{{.Id}}'
CLI_RUNNER_IMAGE=
CLI_CODEX_AUTH_VOLUME=auto-reviewer_codex-auth
CLI_CLAUDE_AUTH_VOLUME=auto-reviewer_claude-auth

# Optional final-review summary journal. Disabled unless explicitly configured and allowlisted.
JOURNAL_ENABLED=0
JOURNAL_ENDPOINT=https://tsunagu.ainzw0rth.xyz/api/v1/sessions
JOURNAL_CREDENTIAL_ID=0
JOURNAL_REPOSITORIES=

# Optional approval alerts via your existing Hermes Telegram bot. No historical backfill.
# Credential value: JSON {"token":"BOT_TOKEN","chat_id":"PRIVATE_CHAT_ID"}, stored encrypted.
TELEGRAM_APPROVAL_ENABLED=0
TELEGRAM_APPROVAL_CREDENTIAL_ID=0
TELEGRAM_APPROVAL_SINCE=
TELEGRAM_APPROVAL_REPOSITORIES=

# Optional isolated structural evidence. Empty allowlist preserves existing behavior.
GRAPH_REPOSITORIES=
# Pin the graph image ID from docker image inspect (sha256:...), not a mutable tag.
GRAPH_RUNNER_IMAGE=
GRAPH_CACHE_VOLUME=auto-reviewer-graph-cache
GRAPH_TIMEOUT_SECONDS=1200
